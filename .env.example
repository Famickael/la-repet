# Toutes les variables sont facultatives. Sans elles, tout fonctionne dans le navigateur.

# Transcription par un service serveur (format OpenAI audio/transcriptions, verbose_json),
# par exemple un proxy vers Mistral Voxtral hébergé en France. Sinon : Whisper local.
# VITE_STT_ENDPOINT=https://api.votre-organisme.fr/stt
# VITE_STT_MODEL=voxtral-mini-latest

# Modèle Whisper local (transformers.js) et hébergement des modèles
# VITE_WHISPER_MODEL=onnx-community/whisper-base
# VITE_MODELS_BASE_URL=https://static.votre-organisme.fr/models/
# Révision figée du modèle Whisper (identifiant de commit Hugging Face), « main » par défaut
# VITE_WHISPER_REVISION=main

# Modèle de langage facultatif (retour reformulé, assistants), via un proxy "chat completions" sans état
# (modèle : serveur/llm-proxy ; Cloudflare Worker, Netlify Function ou fonction Supabase au choix).
# Le fournisseur, le modèle et la clé (LLM_API_KEY) se règlent dans les secrets du proxy, JAMAIS ici :
# toute variable VITE_* est copiée dans le JavaScript public. Voir AGENTS.md, section 8.
# VITE_LLM_ENDPOINT=https://proxy.votre-organisme.fr/
# Facultatif : imposer un modèle depuis le navigateur (sinon le proxy choisit selon la tâche).
# VITE_LLM_MODEL=

# Suivi du regard (MediaPipe) : fichiers auto-hébergés.
# Par défaut : moteur @mediapipe/tasks-vision 1.2.3 servi par le site (dossier mediapipe/), modèles « float16/1 » sur storage.googleapis.com
# VITE_MEDIAPIPE_WASM=/mediapipe/wasm
# VITE_FACE_MODEL=/models/face_landmarker.task
# Fond flou ou uni pendant l'échauffement vidéo (MediaPipe Image Segmenter)
# VITE_SEGMENTER_MODEL=/models/selfie_segmenter.tflite

# Mode des textes d'information : sans VITE_BACKEND_URL, les textes « prototype » sont affichés
# (tout reste dans le navigateur). Voir src/content/organisme.js pour les champs à compléter.
# VITE_BACKEND_URL=https://api.votre-organisme.fr
